#!/usr/bin/env bash
# Sobe o servidor local (se ainda não estiver de pé) e abre a janela do app.
# É este script que o atalho do menu do Omarchy executa.

set -euo pipefail

APP_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PORT="${FAROL_PORT:-7788}"
URL="http://127.0.0.1:${PORT}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/farol"
LOG="$DATA_DIR/server.log"
VENV="$APP_DIR/.venv"

mkdir -p "$DATA_DIR"

running() {
  curl -fsS --max-time 1 "$URL/saude" 2>/dev/null | grep -q '"farol"'
}

start_server() {
  if [ ! -x "$VENV/bin/python" ]; then
    echo "Ambiente não instalado. Rode: $APP_DIR/install.sh" >&2
    command -v notify-send >/dev/null && \
      notify-send "Farol" "Ambiente não instalado. Rode install.sh no diretório do app."
    exit 1
  fi
  echo "--- $(date -Is) iniciando farol na porta $PORT" >>"$LOG"
  ( cd "$APP_DIR" && nohup "$VENV/bin/python" -m farol servir --port "$PORT" >>"$LOG" 2>&1 & )
}

open_window() {
  if command -v omarchy-launch-webapp >/dev/null 2>&1; then
    exec omarchy-launch-webapp "$URL"
  fi
  for browser in chromium google-chrome-stable google-chrome brave brave-browser microsoft-edge; do
    if command -v "$browser" >/dev/null 2>&1; then
      exec "$browser" --app="$URL" --class=Farol --name=Farol
    fi
  done
  if command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$URL"
  fi
  echo "Nenhum navegador encontrado. O Farol está rodando em $URL" >&2
  command -v notify-send >/dev/null && notify-send "Farol" "Rodando em $URL"
  exit 0
}

collect_now() {
  # Uma coleta por abertura do app. O servidor recusa sozinho se a última rodada
  # foi há pouco (Ajustes → intervalo mínimo), então reabrir a janela várias
  # vezes seguidas não vira rajada de requisição nos portais.
  curl -fsS -m 5 -X POST "$URL/coleta" >/dev/null 2>&1 || true
}

if ! running; then
  start_server
  for _ in $(seq 1 40); do
    running && break
    sleep 0.25
  done
  if ! running; then
    echo "O servidor não respondeu. Últimas linhas de $LOG:" >&2
    tail -n 20 "$LOG" >&2 || true
    command -v notify-send >/dev/null && notify-send "Farol" "O servidor não subiu. Veja $LOG"
    exit 1
  fi
fi

collect_now &

open_window
